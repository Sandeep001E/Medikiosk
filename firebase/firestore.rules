rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users & Credentials
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Clinical Problem Summaries (Reported Problems)
    match /summaries/{summaryId} {
      allow read, write: if true;
    }
    match /reportedProblems/{problemId} {
      allow read, write: if true;
    }
    
    // Diagnostic Reports & Scans
    match /reports/{reportId} {
      allow read, write: if true;
    }
    
    // Consultation Bridge & Shared Summaries with Doctor Notes
    match /sharedSummaries/{shareId} {
      allow read, write: if true;
    }
    match /doctorSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Prescriptions & Medications
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }
    match /medications/{medicationId} {
      allow read, write: if true;
    }

    // QR Sessions & Consultation Tokens
    match /qrSessions/{sessionId} {
      allow read, write: if true;
    }
    match /qrTokens/{tokenId} {
      allow read, write: if true;
    }
  }
}
